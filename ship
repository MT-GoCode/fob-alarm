#!/bin/bash
# Build a signed release APK, serve it on the LAN, print a QR to scan from each phone.
# No ADB anywhere in this path -- see SPEC.md section 13.
set -euo pipefail
cd "$(dirname "$0")"
export JAVA_HOME="${JAVA_HOME:-/Applications/Android Studio.app/Contents/jbr/Contents/Home}"

PORT=8000
APK=app/build/outputs/apk/release/app-release.apk

echo "==> building"
./gradlew --no-daemon :app:assembleRelease -q

# Pre-flight: USE_EXACT_ALARM must be in the shipped manifest. If it is missing, Android
# wipes every setAlarmClock on update and the runtime gate notices far too late.
AAPT=$(ls -d "$HOME"/Library/Android/sdk/build-tools/* | sort -V | tail -1)/aapt2
if ! "$AAPT" dump permissions "$APK" 2>/dev/null | grep -q "android.permission.USE_EXACT_ALARM"; then
  echo "FATAL: USE_EXACT_ALARM missing from built manifest. Refusing to serve." >&2
  exit 1
fi
echo "==> pre-flight ok (USE_EXACT_ALARM present)"

mkdir -p .serve
cp "$APK" .serve/fobalarm.apk
VC=$("$AAPT" dump badging "$APK" | sed -n "s/.*versionCode='\([0-9]*\)'.*/\1/p")
SHA=$(shasum -a 256 .serve/fobalarm.apk | cut -d' ' -f1)
IP=$(ipconfig getifaddr en0 || ipconfig getifaddr en1)
URL="http://$IP:$PORT/fobalarm.apk"

cat > .serve/manifest.json <<EOF
{"versionCode":$VC,"sha256":"$SHA","url":"$URL","builtAt":$(date +%s000)}
EOF

echo "==> serving $URL"
echo "    sha256 $SHA"
echo

if command -v qrencode >/dev/null 2>&1; then
  qrencode -t ANSIUTF8 "$URL"
else
  echo "    (brew install qrencode for a scannable QR -- type the URL for now)"
fi
echo
echo "    On each phone: open Chrome -> go to the URL above -> download -> install."
echo "    Then pull logs from here with:  ./logs $IP"
echo "    Ctrl-C to stop serving."
cd .serve && exec "$JAVA_HOME/bin/jwebserver" -b 0.0.0.0 -p $PORT -d "$PWD"
