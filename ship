#!/bin/bash
# Build a signed APK, serve it on the LAN, advertise it, print a QR to scan.
# No ADB anywhere in this path. See SPEC.md section 13.
#
#   ./ship          -> dev  flavour (update channel + debug screen compiled in)
#   ./ship live     -> live flavour (both compiled out)
set -euo pipefail
cd "$(dirname "$0")"
export JAVA_HOME="${JAVA_HOME:-/Applications/Android Studio.app/Contents/jbr/Contents/Home}"

FLAVOR="${1:-dev}"
case "$FLAVOR" in
  dev)  TASK=":app:assembleDevRelease";  APK=app/build/outputs/apk/dev/release/app-dev-release.apk ;;
  live) TASK=":app:assembleLiveRelease"; APK=app/build/outputs/apk/live/release/app-live-release.apk ;;
  *) echo "usage: ./ship [dev|live]" >&2; exit 1 ;;
esac
PORT=8000

echo "==> core tests (the whole state machine, no phone needed)"
./gradlew --no-daemon :core:test -q

echo "==> building $FLAVOR"
./gradlew --no-daemon "$TASK" -q

AAPT=$(ls -d "$HOME"/Library/Android/sdk/build-tools/* | sort -V | tail -1)/aapt2

# Pre-flight. USE_EXACT_ALARM missing from the shipped manifest means Android wipes every
# setAlarmClock on update, and the runtime gate notices far too late.
# Capture first: `grep -q` exits on first match, aapt2 dies on SIGPIPE, and with
# `set -o pipefail` the whole pipeline reports failure even on success.
PERMS=$("$AAPT" dump permissions "$APK" 2>/dev/null || true)
if ! printf '%s' "$PERMS" | grep -q "android.permission.USE_EXACT_ALARM"; then
  echo "FATAL: USE_EXACT_ALARM missing from built manifest. Refusing to serve." >&2
  exit 1
fi
echo "==> pre-flight ok (USE_EXACT_ALARM present)"

mkdir -p .serve releases
cp "$APK" .serve/fobalarm.apk
BADGING=$("$AAPT" dump badging "$APK" 2>/dev/null || true)
VC=$(printf '%s' "$BADGING" | sed -n "s/.*versionCode='\([0-9]*\)'.*/\1/p" | head -1)
VN=$(printf '%s' "$BADGING" | sed -n "s/.*versionName='\([^']*\)'.*/\1/p" | head -1)
SHA=$(shasum -a 256 .serve/fobalarm.apk | cut -d' ' -f1)
# Pick the first interface with a real IP, and list the rest: the Mac moving networks
# is the single most common reason a phone cannot see the build.
IP=""
for i in en0 en1 en2 en3 en4 en5 bridge100; do
  CAND=$(ipconfig getifaddr "$i" 2>/dev/null || true)
  if [ -n "$CAND" ]; then IP="${IP:-$CAND}"; fi
done
[ -n "$IP" ] || { echo "FATAL: no network interface has an IP. Join a network first." >&2; exit 1; }
URL="http://$IP:$PORT/fobalarm.apk"

# Keep the N-1 build: a release-signed APK cannot be downgraded in place, so rolling
# back means uninstall + reinstall + restore. Never keep only the newest.
cp "$APK" "releases/fobalarm-$FLAVOR-$VN-$VC.apk"

cat > .serve/manifest.json <<EOF
{"versionCode":$VC,"versionName":"$VN","flavor":"$FLAVOR","sha256":"$SHA","url":"$URL","builtAt":$(date +%s000)}
EOF

# mDNS is the convenience layer, not the primary mechanism. macOS 26 gates Bonjour per
# app, so verify the advertisement rather than assuming it worked.
if command -v dns-sd >/dev/null 2>&1; then
  dns-sd -R alarmdev _alarmdev._tcp local $PORT >/dev/null 2>&1 &
  DNSPID=$!
  trap 'kill $DNSPID 2>/dev/null || true' EXIT
  sleep 1
  if ! timeout 3 dns-sd -B _alarmdev._tcp local 2>/dev/null | grep -q alarmdev; then
    echo "    note: mDNS advertisement not visible. System Settings -> Privacy & Security"
    echo "          -> Local Network -> enable for your terminal. Use the manual IP below."
  fi
fi

echo "==> serving $FLAVOR $VN ($VC) at $URL"
echo "    sha256 $SHA"
echo "    archived releases/fobalarm-$FLAVOR-$VN-$VC.apk"
echo
if command -v qrencode >/dev/null 2>&1; then qrencode -t ANSIUTF8 "$URL"; else echo "    $URL"; fi
echo
ALL=$(ifconfig | awk '/^[a-z]/{i=$1} /inet /{if($2!="127.0.0.1") printf "%s(%s) ", $2, i}')
echo "    This Mac is reachable at: $ALL"
echo "    The phone MUST be on the same network. If its IP does not start with"
echo "    ${IP%.*}. then join it to the same Wi-Fi, or use the phone's hotspot"
echo "    and connect this Mac to that instead, then re-run ./ship."
echo
echo "    Phone: Chrome -> scan/open the URL -> download -> install."
echo "    Update instead: debug screen -> enable dev mode -> Mac IP $IP -> Check for update."
echo "    Logs from here:  ./logs <phone-ip>"
echo "    Ctrl-C to stop."
cd .serve && exec "$JAVA_HOME/bin/jwebserver" -b 0.0.0.0 -p $PORT -d "$PWD"
