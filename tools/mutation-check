def run_suite():
    """Returns the set of failing test names, empty only when the suite genuinely passed.

    The exit code is the authority, not the parsed names: `-q` hides the per-test FAILED lines,
    and an earlier version of this script read that silence as success and reported every mutant
    as survived.
    """
    env = dict(os.environ)
    env.setdefault("JAVA_HOME", "/Applications/Android Studio.app/Contents/jbr/Contents/Home")
    p = subprocess.run(["./gradlew", "test", "--console=plain"],
                       cwd=ROOT, env=env, capture_output=True, text=True)
    out = p.stdout + p.stderr
    if p.returncode == 0:
        return set()
    if "Compilation error" in out or "Syntax error" in out:
        return {"<DID NOT COMPILE>"}
    named = set(re.findall(r"^\w+ > (.+?) FAILED", out, re.M))
    return named or {"<RED, NO TEST NAMES PARSED>"}


def main():
    only = sys.argv[1] if len(sys.argv) > 1 else ""
    mutants = [m for m in MUTANTS if only in m[0]]
    if not mutants:
        sys.exit(f"no mutant id contains {only!r}")

    backup = tempfile.mkdtemp(prefix="mutation-check-")
    files = {m[1] for m in mutants}
    for f in files:
        os.makedirs(os.path.join(backup, os.path.dirname(f)), exist_ok=True)
        shutil.copy(os.path.join(ROOT, f), os.path.join(backup, f))

    def restore():
        for f in files:
            shutil.copy(os.path.join(backup, f), os.path.join(ROOT, f))

    results = []
    try:
        baseline = run_suite()
        if baseline:
            restore()
            sys.exit(f"the suite is not green to begin with: {sorted(baseline)}")
        print(f"baseline green, {len(mutants)} mutants\n")

        for mid, path, old, new, expect in mutants:
            full = os.path.join(ROOT, path)
            src = open(full).read()
            if old not in src:
                results.append((mid, "STALE", "mutant text not found in source"))
                print(f"  {mid:28} STALE  -- mutant no longer applies, fix this script")
                continue
            open(full, "w").write(src.replace(old, new, 1))
            failed = run_suite()
            restore()

            killed_by = [t for t in failed if expect in t]
            if not failed:
                verdict, note = "SURVIVED", "suite stayed green -- nothing observes this"
            elif killed_by:
                verdict, note = "killed", f"by {len(failed)} test(s), incl. the named one"
            else:
                verdict, note = "MISPLACED", f"red, but not {expect!r}: {sorted(failed)[:2]}"
            results.append((mid, verdict, note))
            print(f"  {mid:28} {verdict:9} {note}")
    finally:
        restore()
        shutil.rmtree(backup, ignore_errors=True)

    bad = [r for r in results if r[1] != "killed"]
    print(f"\n{len(results) - len(bad)}/{len(results)} mutants killed by the test that names them")
    if bad:
        print("NOT PROVEN:")
        for mid, verdict, note in bad:
            print(f"  {mid}: {verdict} -- {note}")
    sys.exit(1 if bad else 0)


if __name__ == "__main__":
    main()
